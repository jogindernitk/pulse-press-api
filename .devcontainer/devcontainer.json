{
  "name": "PulsePress API Dev Container",
  "dockerComposeFile": "docker-compose.devcontainer.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/pulse-press-api",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/pulse-press-api/.venv/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  },
  "postCreateCommand": "uv sync",
  "forwardPorts": [
    8000,
    5432
  ],

  "remoteUser": "root"
}
